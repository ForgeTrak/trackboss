{
    "name": "clubmanager-2.0",
    "version": "1.0.0",
    "description": "Palmyra Racing Associate Club Management application backend",
    "main": "server.ts",
    "bin": "build/server.js",
    "scripts": {
        "dev": "concurrently \"npm run frontend\" \"npm run server\"",
        "server": "nodemon --exec npx ts-node src/server.ts",
        "server-prod": "node build/server.js",
        "frontend": "cd frontend && npm start",
        "build": "rm -rf build && tsc --project tsconfig.json",
        "update": "npm install && cd frontend && npm install && cd ..",
        "hard-update": "rm package-lock.json && rm -rf node_modules/ && cd frontend && rm package-lock.json && rm -rf node_modules/ && cd .. && npm run update",
        "new-migration": "cd database/migrations && npx knex migrate:make $npm_config_name",
        "run-migrations": "cd database/migrations && npx knex migrate:latest",
        "seed-db": "mysql -u $MYSQL_USER -p$MYSQL_PASS -h $MYSQL_HOST < seeddump.sql",
        "test": "jest",
        "test:coverage": "jest --coverage"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Squeaky-Training-Wheels/clubmanager-2.0.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Squeaky-Training-Wheels/clubmanager-2.0/issues"
    },
    "homepage": "https://github.com/Squeaky-Training-Wheels/clubmanager-2.0#readme",
    "dependencies": {
        "@aws-sdk/client-cloudwatch-logs": "^3.231.0",
        "@aws-sdk/client-s3": "^3.962.0",
        "@types/body-parser": "^1.19.2",
        "@types/lodash": "^4.14.178",
        "@types/mailchimp__mailchimp_marketing": "^3.0.6",
        "aws-jwt-verify": "^3.2.0",
        "aws-sdk": "^2.1278.0",
        "body-parser": "^1.20.1",
        "date-fns": "^2.29.3",
        "dotenv": "^16.0.3",
        "exceljs": "^4.3.0",
        "express": "^4.18.2",
        "handlebars": "^4.7.8",
        "ical-generator": "^8.1.1",
        "jsondiffpatch": "^0.7.3",
        "knex": "^3.1.0",
        "lodash": "^4.17.21",
        "mysql2": "^3.11.5",
        "sanitize-html": "^2.13.1",
        "square": "^43.0.2",
        "uuid": "^9.0.1",
        "winston": "^3.8.2",
        "winston-cloudwatch": "^6.1.1"
    },
    "devDependencies": {
        "@babel/core": "^7.17.4",
        "@babel/preset-env": "^7.16.8",
        "@babel/preset-typescript": "^7.16.7",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.0",
        "@types/node-cron": "^3.0.11",
        "@types/pdfkit": "^0.13.3",
        "@types/sanitize-html": "^2.13.0",
        "@types/supertest": "^6.0.0",
        "@types/uuid": "^9.0.7",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "async-mutex": "^0.4.0",
        "babel-jest": "^29.7.0",
        "concurrently": "^7.6.0",
        "cross-env": "^7.0.3",
        "eslint": "^8.56.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-import-resolver-typescript": "^3.6.0",
        "eslint-plugin-import": "^2.24.2",
        "jest": "^29.7.0",
        "jest-mock-extended": "^3.0.0",
        "nodemon": "^3.0.1",
        "supertest": "^6.2.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.7.0"
    }
}
